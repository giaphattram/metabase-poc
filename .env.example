# Copy to .env and fill in ONE provider. .env is git-ignored.
# Metabot also accepts the key in the UI: Admin > AI.

# Anthropic
#MB_LLM_ANTHROPIC_API_KEY=
#MB_LLM_METABOT_PROVIDER=anthropic/claude-sonnet-4-6

# OpenAI
#MB_LLM_OPENAI_API_KEY=
#MB_LLM_METABOT_PROVIDER=openai/gpt-5.4

# Pin a Metabase image tag for reproducibility (default: latest)
#METABASE_TAG=latest

# Admin account created by scripts/bootstrap.sh
#POC_ADMIN_EMAIL=admin@poc.local
#POC_ADMIN_PASSWORD=Metabot-poc-1
